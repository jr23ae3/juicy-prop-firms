// Juicy Prop Firms — PostgreSQL schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users (synced from Supabase Auth)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique @map("supabase_id")
  email      String   @unique
  name       String?
  avatarUrl  String?  @map("avatar_url")
  role       UserRole @default(USER)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  savedPlans  SavedPlan[]
  preferences UserPreferences?
  dealAlerts  DealAlert[]
  subscription Subscription?
  emailLogs   EmailLog[]

  @@map("users")
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingStyle       String?  @map("trading_style")
  experienceLevel    String?  @map("experience_level")
  preferredSize      Int?     @map("preferred_size")
  maxBudget          Decimal? @map("max_budget") @db.Decimal(10, 2)
  evalTypePreference String?  @map("eval_type_preference")
  priority           String?
  alertsEnabled      Boolean  @default(true) @map("alerts_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model DealAlert {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String?   @map("plan_id")
  plan              Plan?     @relation(fields: [planId], references: [id], onDelete: Cascade)
  firmSlug          String?   @map("firm_slug")
  maxAllIn          Decimal?  @map("max_all_in") @db.Decimal(10, 2)
  label             String?
  isActive          Boolean   @default(true) @map("is_active")
  lastNotifiedAt    DateTime? @map("last_notified_at")
  lastNotifiedAllIn Decimal?  @map("last_notified_all_in") @db.Decimal(10, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  emailLogs EmailLog[]

  @@index([userId, isActive])
  @@map("deal_alerts")
}

// ---------------------------------------------------------------------------
// Prop Firms & Plans
// ---------------------------------------------------------------------------

model PropFirm {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?  @db.Text
  websiteUrl   String?  @map("website_url")
  logoUrl      String?  @map("logo_url")
  isActive     Boolean  @default(true) @map("is_active")
  rankScore    Float?   @map("rank_score")
  rankPosition Int?     @map("rank_position")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plans    Plan[]
  rankings FirmRanking[]

  @@index([isActive, rankPosition])
  @@map("prop_firms")
}

enum EvalType {
  CHALLENGE
  DIRECT_TO_FUNDED
  INSTANT_FUNDING
}

enum DrawdownType {
  END_OF_DAY
  TRAILING
  STATIC
}

model Plan {
  id              String        @id @default(cuid())
  propFirmId      String        @map("prop_firm_id")
  propFirm        PropFirm      @relation(fields: [propFirmId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  accountSize     Int           @map("account_size")
  evalType        EvalType      @map("eval_type")
  evalPrice       Decimal       @map("eval_price") @db.Decimal(10, 2)
  activationFee   Decimal       @default(0) @map("activation_fee") @db.Decimal(10, 2)
  profitTarget    Decimal?      @map("profit_target") @db.Decimal(10, 2)
  maxDrawdown     Decimal?      @map("max_drawdown") @db.Decimal(10, 2)
  dailyDrawdown   Decimal?      @map("daily_drawdown") @db.Decimal(10, 2)
  drawdownType    DrawdownType? @map("drawdown_type")
  minimumDays     Int?          @map("minimum_days")
  profitSplit     Decimal?      @map("profit_split") @db.Decimal(5, 4)
  maxPayout       Decimal?      @map("max_payout") @db.Decimal(10, 2)
  minimumDaysToPayout       Int?     @map("minimum_days_to_payout")
  minimumTargetGoalCushion  Decimal? @map("minimum_target_goal_cushion") @db.Decimal(10, 2)
  maxFundedAccounts         Int?     @map("max_funded_accounts")
  payoutFrequency String?       @map("payout_frequency")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  discounts Discount[]
  savedBy   SavedPlan[]
  dealAlerts DealAlert[]

  @@unique([propFirmId, slug])
  @@index([isActive, accountSize])
  @@map("plans")
}

model Discount {
  id          String    @id @default(cuid())
  planId      String    @map("plan_id")
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  code        String
  discountPct Decimal?  @map("discount_pct") @db.Decimal(5, 4)
  discountAmt Decimal?  @map("discount_amt") @db.Decimal(10, 2)
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([planId, isActive])
  @@map("discounts")
}

// ---------------------------------------------------------------------------
// Rankings
// ---------------------------------------------------------------------------

model FirmRanking {
  id         String   @id @default(cuid())
  propFirmId String   @map("prop_firm_id")
  propFirm   PropFirm @relation(fields: [propFirmId], references: [id], onDelete: Cascade)
  score      Float
  position   Int
  period     String
  factors    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([propFirmId, period])
  @@index([period, position])
  @@map("firm_rankings")
}

model SavedPlan {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String   @map("plan_id")
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, planId])
  @@map("saved_plans")
}

// ---------------------------------------------------------------------------
// Stripe Subscriptions (Milestone 8)
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String             @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Email notifications (Milestone 9)
// ---------------------------------------------------------------------------

enum EmailType {
  DEAL_ALERT
  WELCOME
  SUBSCRIPTION_CONFIRMATION
}

enum EmailStatus {
  SENT
  FAILED
}

model EmailLog {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealAlertId String?     @map("deal_alert_id")
  dealAlert   DealAlert?  @relation(fields: [dealAlertId], references: [id], onDelete: SetNull)
  type        EmailType
  toEmail     String      @map("to_email")
  subject     String
  status      EmailStatus @default(SENT)
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([userId, type])
  @@index([dealAlertId])
  @@map("email_logs")
}
