# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth (required for Milestone 2 auth)
# Create a project at https://supabase.com — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL / Prisma (required for Milestone 2 database)
# Use Supabase Postgres, Neon, or local Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/juicy_prop_firms
DIRECT_URL=postgresql://user:password@localhost:5432/juicy_prop_firms

# OpenAI (Milestone 6)
OPENAI_API_KEY=

# Stripe (Milestone 8)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend Email (Milestone 9)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
